# Configuração de Banco de Dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/central_implantacoes?schema=public"

# Autenticação e Sessões (NextAuth)
NEXTAUTH_SECRET="chave-secreta-de-desenvolvimento-central-de-implantacoes-centi"
NEXTAUTH_URL="http://localhost:3000"

# Armazenamento de Arquivos Privados (local ou s3)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./data/storage"

# Configuração S3 / MinIO (usado quando STORAGE_DRIVER=s3)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="documentos-centi"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# Segredo para acionamento de rotinas de alerta (/api/cron/check-alerts)
CRON_SECRET="segredo-cron-central-centi-2026"

# Fuso Horário de Referência dos Projetos
APP_TIMEZONE="America/Sao_Paulo"

# Credenciais Iniciais de Provisionamento (npm run auth:provision-admin)
INITIAL_ADMIN_EMAIL="admin@centi.com.br"
INITIAL_ADMIN_PASSWORD="Admin@Centi2026"
INITIAL_ADMIN_NAME="Administrador do Sistema"
INITIAL_ORG_NAME="Centi Soluções LTDA"
INITIAL_ORG_CNPJ="14.419.896/0001-52"
